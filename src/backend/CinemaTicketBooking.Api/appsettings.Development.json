{
  "GuestCheckout": {
    "LifetimeHours": 24,
    "AllowedOrigins": [
      "http://127.0.0.1:5173"
    ],
    "AllowInsecureLoopbackCookies": true,
    "CrossSiteCookies": false,
    "BootstrapPermitLimit": 20,
    "BootstrapWindowSeconds": 60
  },
  "BookingExpiry": {
    "Enabled": true,
    "PollIntervalSeconds": 15,
    "BatchSize": 50
  },
  "Selection": {
    "MaximumTickets": 8
  },
  "MockPay": {
    "BaseUrl": "https://promethe-mock-payment.promethe-phos.workers.dev",
    "Provider": "MockPay",
    "PaymentWindowSeconds": 600,
    "GraceSeconds": 10
  }
}
