        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n \"selectionId\": \"{{selectionId}}\",\n \"selectionVersion\": \"{{selectionVersion}}\",\n \"showtimeId\": \"{{showtimeId}}\",\n \"seatIds\": {{seatIds}},\n \"quantities\": {\"adult\": {{adult}}, \"discounted\": {{discounted}}},\n \"contact\": {\"fullName\": \"{{contactFullName}}\", \"phone\": \"{{contactPhone}}\", \"email\": \"{{contactEmail}}\"},\n \"declarations\": {\"termsAccepted\": true, \"ageRequirementsAcknowledged\": true},\n \"priceAcceptance\": {\"quoteId\": \"{{quoteId}}\", \"version\": \"{{quoteVersion}}\", \"acceptedTotal\": {{conflictingTotal}}}\n}",
          "options": {
            "raw": {
