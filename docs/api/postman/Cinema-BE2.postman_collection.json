{
  "info": {
    "name": "Cinema BE2 — Task 4 — Guest, Reservation and Recovery",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Implemented BE2 tasks 1–4. Run 01–19 in order with the Cinema BE2 Local environment and real available local seat IDs. Requests 15–19 exercise booking reads, checkout recovery, reload, missing Guest proof and missing booking. Complete reservation within the original five-minute deadline. GET never extends a deadline or creates a booking/payment. Creates real local holds; use other available seats on reruns until task 5 adds safe expiry. MoMo is a frontend method choice only; no gateway, ticket or email calls. Revision 1.4.0; replace older imports.",
    "_postman_id": "9af7aa63-f175-4c22-b27c-fed2536e57fd",
    "version": "1.4.0"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "01 Bootstrap Guest",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{guestBootstrapKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/guest-context",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "guest-context"
          ]
        },
        "description": "Postman retains cinema_guest in its cookie jar. Do not disable cookies. CSRF is captured into the selected local environment; never share an environment exported with live values."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "['selectionId', 'selectionVersion', 'selectionDeadline', 'staleSelectionVersion', 'quoteId', 'quoteVersion', 'acceptedTotal', 'bookingId', 'bookingRequestKey', 'bookingVersion'].forEach(key => pm.environment.unset(key));",
              "pm.environment.set('guestBootstrapKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Guest created or reused', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  pm.environment.set('contextId', pm.response.json().data.contextId);",
              "  pm.environment.set('csrfToken', pm.response.headers.get('X-CSRF-Token'));",
              "}",
              "pm.test('CSRF header supplied', () => pm.expect(pm.response.headers.has('X-CSRF-Token')).to.eql(true));"
            ]
          }
        }
      ]
    },
