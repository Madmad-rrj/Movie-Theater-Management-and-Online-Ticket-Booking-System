            "type": "text/javascript",
            "exec": [
              "pm.test('Reservation replay returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Same booking returned', () => pm.expect(pm.response.json().data.bookingId).to.eql(pm.environment.get('bookingId')));",
              "pm.test('Replay marker present', () => pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'));",
              "if (pm.response.code === 200) {",
              " const booking = pm.response.json().data;",
              " pm.test('Replay retains original deadline', () => pm.expect(booking.selectionDeadline).to.eql(pm.environment.get('selectionDeadline')));",
              " pm.test('Replay retains accepted total', () => pm.expect(booking.financialSnapshot.total).to.deep.eql(JSON.parse(pm.environment.get('acceptedTotal'))));",
              " pm.test('Replay retains selected seats', () => pm.expect(booking.seats.map(seat => seat.seatId).sort()).to.deep.eql(JSON.parse(pm.environment.get('seatIds')).sort()));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Reject changed payload with same reservation key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
