        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Consumed selection rejected', () => pm.response.to.have.status(409));",
              "pm.test('State conflict', () => pm.expect(pm.response.json().error.code).to.eql('STATE_CONFLICT'));"
            ]
          }
        }
      ]
    }
  ]
}
