          "path": [
            "api",
            "selections",
            "{{selectionId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n \"version\": \"{{selectionVersion}}\",\n \"quantities\": {\"adult\": {{adult}}, \"discounted\": {{discounted}}},\n \"seatIds\": {{seatIds}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Complete selection restored', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              " const data = pm.response.json().data;",
              " pm.environment.set('selectionVersion', data.version);",
              " pm.environment.set('selectionDeadline', data.selectionDeadline);",
              " if (data.quote) {",
              "  pm.environment.set('quoteId', data.quote.quoteId);",
              "  pm.environment.set('quoteVersion', data.quote.version);",
              "  pm.environment.set('acceptedTotal', JSON.stringify(data.quote.total));",
              " }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Reserve booking and hold seats",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{bookingRequestKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n \"selectionId\": \"{{selectionId}}\",\n \"selectionVersion\": \"{{selectionVersion}}\",\n \"showtimeId\": \"{{showtimeId}}\",\n \"seatIds\": {{seatIds}},\n \"quantities\": {\"adult\": {{adult}}, \"discounted\": {{discounted}}},\n \"contact\": {\"fullName\": \"{{contactFullName}}\", \"phone\": \"{{contactPhone}}\", \"email\": \"{{contactEmail}}\"},\n \"declarations\": {\"termsAccepted\": true, \"ageRequirementsAcknowledged\": true},\n \"priceAcceptance\": {\"quoteId\": \"{{quoteId}}\", \"version\": \"{{quoteVersion}}\", \"acceptedTotal\": {{acceptedTotal}}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const seats = JSON.parse(pm.environment.get('seatIds') || '[]');",
              "const total = Number(pm.environment.get('adult')) + Number(pm.environment.get('discounted'));",
              "if (seats.length !== total || !pm.environment.get('quoteId')) throw new Error('Run request 10 first with exactly as many seatIds as tickets.');",
              "pm.environment.set('bookingRequestKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Pending booking created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              " const booking = pm.response.json().data;",
              " pm.environment.set('bookingId', booking.bookingId);",
              " pm.test('Booking remains pending', () => pm.expect(booking.status).to.eql('pending'));",
              " pm.test('Original deadline retained', () => pm.expect(booking.selectionDeadline).to.eql(pm.environment.get('selectionDeadline')));",
              " pm.test('Accepted amount committed', () => pm.expect(booking.financialSnapshot.total).to.deep.eql(JSON.parse(pm.environment.get('acceptedTotal'))));",
              " pm.test('No payment started', () => pm.expect(booking.activePaymentId).to.eql(null));",
              "}"
            ]
          }
        }
      ]
    },
