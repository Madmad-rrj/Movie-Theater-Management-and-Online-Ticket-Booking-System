# Local PostgreSQL demo configuration.
# Copy this file to .env and change the local password if needed.
# Never commit .env or a real production/cloud connection string.

POSTGRES_DB=cinema_demo
POSTGRES_USER=cinema_demo
POSTGRES_PASSWORD=cinema_demo_local_only
POSTGRES_HOST_PORT=5433

# Optional BE2 API expiry worker overrides (local Docker profile).
# Defaults already enable safe cleanup every 15 seconds, up to 50 candidates.
CINEMA_BE2_EXPIRY_ENABLED=true
CINEMA_BE2_EXPIRY_POLL_SECONDS=15
CINEMA_BE2_EXPIRY_BATCH_SIZE=50
